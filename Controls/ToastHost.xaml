<UserControl x:Class="Nasaq.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{x:Null}">

    <!-- Nothing paints outside the cards, so the toast layer never blocks the
         workspace behind it. -->
    <Grid Background="{x:Null}">
        <ItemsControl x:Name="Items"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,18,56" Width="382"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                            CornerRadius="13" Margin="0,8,0,0"
                            Effect="{StaticResource Shadow.Popup}"
                            RenderTransformOrigin="1,0.5"
                            Loaded="ToastCard_Loaded">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Stripe" Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="13,0,0,13" />

                            <Grid Grid.Column="1" Margin="12,10,4,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Icon" Width="32" Height="32" CornerRadius="9"
                                        Background="{DynamicResource Brush.AccentSoft}"
                                        VerticalAlignment="Top">
                                    <TextBlock x:Name="Glyph" Style="{StaticResource IconGlyph}"
                                               Text="&#xE946;" FontSize="14"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="12.5"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Message}" FontSize="10.75"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                    Width="26" Height="26" Margin="0,7,8,0"
                                    VerticalAlignment="Top" Focusable="False"
                                    ToolTip="Dismiss" Click="Close_Click">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE711;" FontSize="9.5" />
                            </Button>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="Icon" Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                            <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Brush.Warning}" />
                            <Setter TargetName="Icon" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Icon" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
