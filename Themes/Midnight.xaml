<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Midnight theme · generated palette -->
    <sys:String x:Key="Theme.Marker">midnight</sys:String>

    <Color x:Key="Color.WindowBg">#07090C</Color>
    <Color x:Key="Color.TitleBarBg">#0C0F14</Color>
    <Color x:Key="Color.ContentBg">#0B0E13</Color>
    <Color x:Key="Color.Surface">#12161D</Color>
    <Color x:Key="Color.SurfaceAlt">#181D26</Color>
    <Color x:Key="Color.SurfaceHover">#1D2430</Color>
    <Color x:Key="Color.SurfacePressed">#232B39</Color>
    <Color x:Key="Color.Border">#232A35</Color>
    <Color x:Key="Color.BorderStrong">#333C4A</Color>
    <Color x:Key="Color.Text">#F2F5FA</Color>
    <Color x:Key="Color.TextMuted">#9AA5B5</Color>
    <Color x:Key="Color.TextFaint">#6A7587</Color>
    <Color x:Key="Color.Accent">#7C9CFF</Color>
    <Color x:Key="Color.AccentHover">#94AEFF</Color>
    <Color x:Key="Color.AccentText">#0A0E18</Color>
    <Color x:Key="Color.AccentSoft">#1E2A44</Color>
    <Color x:Key="Color.Danger">#FF6B6B</Color>
    <Color x:Key="Color.DangerSoft">#3A1D22</Color>
    <Color x:Key="Color.Success">#4ADE9F</Color>
    <Color x:Key="Color.SuccessSoft">#123328</Color>
    <Color x:Key="Color.Warning">#F4C15D</Color>
    <Color x:Key="Color.WarningSoft">#3A2F16</Color>
    <Color x:Key="Color.Track">#1B212B</Color>
    <Color x:Key="Color.WindowEdge">#1D242E</Color>
    <Color x:Key="Color.Overlay">#D907090C</Color>
    <SolidColorBrush x:Key="Brush.WindowBg" Color="{StaticResource Color.WindowBg}" />
    <SolidColorBrush x:Key="Brush.TitleBarBg" Color="{StaticResource Color.TitleBarBg}" />
    <SolidColorBrush x:Key="Brush.ContentBg" Color="{StaticResource Color.ContentBg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.WindowEdge" Color="{StaticResource Color.WindowEdge}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
</ResourceDictionary>
