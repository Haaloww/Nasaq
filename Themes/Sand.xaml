<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Sand theme · generated palette -->
    <sys:String x:Key="Theme.Marker">sand</sys:String>

    <Color x:Key="Color.WindowBg">#E8DFD1</Color>
    <Color x:Key="Color.TitleBarBg">#FAF5EC</Color>
    <Color x:Key="Color.ContentBg">#F6F0E6</Color>
    <Color x:Key="Color.Surface">#FFFCF6</Color>
    <Color x:Key="Color.SurfaceAlt">#F4EDE1</Color>
    <Color x:Key="Color.SurfaceHover">#EFE6D7</Color>
    <Color x:Key="Color.SurfacePressed">#E8DDCB</Color>
    <Color x:Key="Color.Border">#E2D6C3</Color>
    <Color x:Key="Color.BorderStrong">#CDBCA3</Color>
    <Color x:Key="Color.Text">#2B241C</Color>
    <Color x:Key="Color.TextMuted">#6D6152</Color>
    <Color x:Key="Color.TextFaint">#928475</Color>
    <Color x:Key="Color.Accent">#C46A43</Color>
    <Color x:Key="Color.AccentHover">#A95734</Color>
    <Color x:Key="Color.AccentText">#FFF8F2</Color>
    <Color x:Key="Color.AccentSoft">#F4E1D6</Color>
    <Color x:Key="Color.Danger">#B6403A</Color>
    <Color x:Key="Color.DangerSoft">#F7E3E1</Color>
    <Color x:Key="Color.Success">#4F7C4A</Color>
    <Color x:Key="Color.SuccessSoft">#E6EFE2</Color>
    <Color x:Key="Color.Warning">#9A6B1F</Color>
    <Color x:Key="Color.WarningSoft">#F5E9D2</Color>
    <Color x:Key="Color.Track">#E9DFCF</Color>
    <Color x:Key="Color.WindowEdge">#DACDB9</Color>
    <Color x:Key="Color.Overlay">#E6F6F0E6</Color>
    <SolidColorBrush x:Key="Brush.WindowBg" Color="{StaticResource Color.WindowBg}" />
    <SolidColorBrush x:Key="Brush.TitleBarBg" Color="{StaticResource Color.TitleBarBg}" />
    <SolidColorBrush x:Key="Brush.ContentBg" Color="{StaticResource Color.ContentBg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.WindowEdge" Color="{StaticResource Color.WindowEdge}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
</ResourceDictionary>
