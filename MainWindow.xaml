<Window x:Class="Nasaq.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nasaq.Views"
        xmlns:controls="clr-namespace:Nasaq.Controls"
        Title="Nasaq"
        Width="1120" Height="720"
        MinWidth="1120" MinHeight="720" MaxWidth="1120" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBg}"
        Icon="pack://application:,,,/Assets/nasaq.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="SectionTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="AmbientStoryboard">
            <DoubleAnimation Storyboard.TargetName="GlowATranslate" Storyboard.TargetProperty="X"
                             From="0" To="90" Duration="0:0:28" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowATranslate" Storyboard.TargetProperty="Y"
                             From="0" To="44" Duration="0:0:34" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowBTranslate" Storyboard.TargetProperty="X"
                             From="0" To="-78" Duration="0:0:31" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowBTranslate" Storyboard.TargetProperty="Y"
                             From="0" To="-54" Duration="0:0:37" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowCTranslate" Storyboard.TargetProperty="X"
                             From="0" To="64" Duration="0:0:42" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowCTranslate" Storyboard.TargetProperty="Y"
                             From="0" To="-40" Duration="0:0:46" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.ContentBg}"
            BorderBrush="{DynamicResource Brush.WindowEdge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- ═══════════════ Custom title bar ═══════════════ -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Brush.TitleBarBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" />

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.SurfaceAlt}">
                        <Image Source="pack://application:,,,/Assets/logo-64.png" Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Nasaq" FontFamily="{DynamicResource Font.Display}" FontSize="14.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
                    <Border Width="3" Height="3" CornerRadius="2" Background="{DynamicResource Brush.TextFaint}"
                            Margin="9,0" VerticalAlignment="Center" />
                    <TextBlock Text="MEDIA TOOLKIT" FontSize="8.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="5" Padding="6,1"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="1.0" FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="SectionNav" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="NavQueueButton" Style="{StaticResource SectionTab}" Click="Queue_Click"
                            ToolTip="Conversion queue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8F1;" FontSize="11"
                                       Margin="0,0,6,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Queue" FontSize="11.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavInstallerButton" Style="{StaticResource SectionTab}" Click="Installer_Click"
                            ToolTip="Download from a link (Ctrl+I)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE896;" FontSize="11"
                                       Margin="0,0,6,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Installer" FontSize="11.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavEditorButton" Style="{StaticResource SectionTab}" Click="Editor_Click"
                            ToolTip="Editor — coming soon">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70F;" FontSize="11"
                                       Margin="0,0,6,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Editor" FontSize="11.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="4"
                                    Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SOON" FontSize="7" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Warning}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,9,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="Shelf_Click"
                            ToolTip="Drop shelf (Ctrl+Alt+D)" Margin="0,0,2,0">                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A0;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Appearance_Click"
                            ToolTip="Change theme" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE790;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="{DynamicResource Font.Icons}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource Font.Icons}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════ Pages ═══════════════ -->
            <Grid Grid.Row="1">
                <!-- Ambient theme glows; toggled in Settings → Appearance. -->
                <Grid x:Name="AmbientLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.AnimatedBackground}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Canvas>
                        <Ellipse Width="720" Height="720" Canvas.Left="-260" Canvas.Top="-320" Opacity="0.11">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{DynamicResource Color.Accent}" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="GlowATranslate" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="560" Height="560" Canvas.Left="720" Canvas.Top="300" Opacity="0.075">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{DynamicResource Color.Success}" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="GlowBTranslate" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="440" Height="440" Canvas.Left="390" Canvas.Top="-220" Opacity="0.055">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{DynamicResource Color.Warning}" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="GlowCTranslate" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Grid>

                <views:MainView x:Name="MainPage">
                    <views:MainView.RenderTransform>
                        <TranslateTransform />
                    </views:MainView.RenderTransform>
                </views:MainView>
                <views:InstallerView x:Name="InstallerPage" Visibility="Collapsed"
                                    DataContext="{Binding Installer}">
                    <views:InstallerView.RenderTransform>
                        <TranslateTransform />
                    </views:InstallerView.RenderTransform>
                </views:InstallerView>
                <views:EditorView x:Name="EditorPage" Visibility="Collapsed"
                                  DataContext="{Binding Editor}">
                    <views:EditorView.RenderTransform>
                        <TranslateTransform />
                    </views:EditorView.RenderTransform>
                </views:EditorView>
                <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed">
                    <views:SettingsView.RenderTransform>
                        <TranslateTransform />
                    </views:SettingsView.RenderTransform>
                </views:SettingsView>

                <Border x:Name="DropOverlay" Background="{DynamicResource Brush.Overlay}"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <Border Width="420" Height="210" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2" CornerRadius="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Effect="{StaticResource Shadow.Popup}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="54" Height="54" CornerRadius="15"
                                    Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;" FontSize="24"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock Text="Drop to add files" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,13,0,0" />
                            <TextBlock Text="They'll be queued and converted in the background."
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- ═══════════════ Status footer ═══════════════ -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.TitleBarBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Margin="8,0,0,0" ToolTip="{Binding EngineTitle}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Brush.TextFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineAvailable}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineAvailable}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,17,0">
                        <Button Style="{StaticResource GhostButton}" Click="Shelf_Click" Padding="9,6"
                                ToolTip="Open a floating drop target">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A0;" FontSize="12"
                                           Margin="0,0,6,0" Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock Text="Drop shelf" FontSize="11.5" />
                                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="4"
                                        Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HotkeyHint}" FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="8.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="FooterInstallerButton" Style="{StaticResource GhostButton}"
                                Click="Installer_Click" Padding="9,6" Margin="6,0,0,0"
                                ToolTip="Download from a link (Ctrl+I)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FooterInstallerIcon" Style="{StaticResource IconGlyph}"
                                           Text="&#xE896;" FontSize="12" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock x:Name="FooterInstallerLabel" Text="Installer" FontSize="11.5" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="FooterEditorButton" Style="{StaticResource GhostButton}"
                                Click="Editor_Click" Padding="9,6" Margin="6,0,0,0"
                                ToolTip="Editor — coming soon">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FooterEditorIcon" Style="{StaticResource IconGlyph}"
                                           Text="&#xE70F;" FontSize="12" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock x:Name="FooterEditorLabel" Text="Editor" FontSize="11.5" />
                                <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="4"
                                        Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SOON" FontSize="7" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Warning}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="FooterSettingsButton" Style="{StaticResource SecondaryButton}"
                                Click="Settings_Click" Padding="12,6" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FooterSettingsIcon" Style="{StaticResource IconGlyph}"
                                           Text="&#xE713;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock x:Name="FooterSettingsLabel" Text="Settings" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Non-blocking notification layer: errors, warnings and confirmations
                 fade in here instead of interrupting with a native message box. -->
            <controls:ToastHost Grid.RowSpan="3" Panel.ZIndex="100" />
        </Grid>
    </Border>
</Window>
