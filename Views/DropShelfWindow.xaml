<Window x:Class="Nasaq.Views.DropShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nasaq Drop Shelf" Width="480" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="18">
        <Border Background="{DynamicResource Brush.ContentBg}" CornerRadius="18"
                BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                Effect="{StaticResource Shadow.Popup}">
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Brush.SurfaceAlt}">
                            <Image Source="pack://application:,,,/Assets/logo-64.png" Width="26" Height="26"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Drop shelf" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="ShelfSubtitle" Text="Drop files, then press Enter or Convert"
                                       Style="{StaticResource Caption}" FontSize="9.5" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource LinkButton}" Content="Open Nasaq" FontSize="10"
                                Click="OpenApp_Click" Margin="0,0,7,0" ToolTip="Show the main window" />
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Click="Close_Click"
                                ToolTip="Close (Esc)">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8BB;" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Per-category targets -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" CornerRadius="11"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Padding="11,9" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xEB9F;" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,5,0" />
                                <TextBlock Text="Images" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <ComboBox Height="30" FontSize="11.5" Margin="0,4,0,0"
                                      x:Name="ImageTarget" ItemsSource="{Binding ImageFormats}" DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Settings.LastImageFormat, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8D6;" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,5,0" />
                                <TextBlock Text="Audio" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <ComboBox Height="30" FontSize="11.5" Margin="0,4,0,0"
                                      x:Name="AudioTarget" ItemsSource="{Binding AudioFormats}" DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Settings.LastAudioFormat, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,9,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE714;" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,5,0" />
                                <TextBlock Text="Video" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <ComboBox Height="30" FontSize="11.5" Margin="0,4,0,0"
                                      x:Name="VideoTarget" ItemsSource="{Binding VideoFormats}" DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Settings.LastVideoFormat, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,9,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A5;" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,5,0" />
                                <TextBlock Text="Documents" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <ComboBox Height="30" FontSize="11.5" Margin="0,4,0,0"
                                      x:Name="DocumentTarget" ItemsSource="{Binding DocumentFormats}" DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Settings.LastDocumentFormat, Mode=TwoWay}" />
                        </StackPanel>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE714;" FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,5,0" />
                                <TextBlock Text="Video sound" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="uses the Audio target" Style="{StaticResource Caption}"
                                           FontSize="9.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.ExtractAudioFromVideo, Mode=TwoWay}"
                                          ToolTip="Turn video files into audio files using the Audio target above" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Drop surface -->
                <Border x:Name="DropSurface" Grid.Row="2" Margin="0,12,0,11" CornerRadius="13"
                        Background="{DynamicResource Brush.Surface}" BorderThickness="0"
                        AllowDrop="True" DragEnter="Surface_DragEnter"
                        DragOver="Surface_DragOver" DragLeave="Surface_DragLeave" Drop="Surface_Drop">
                    <Grid>
                        <!-- The dashed stroke is the drop surface outline; keep it on the edge. -->
                        <Rectangle x:Name="Dash" RadiusX="12.5" RadiusY="12.5" Margin="0.6"
                                   Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1.2"
                                   StrokeDashArray="5 4" IsHitTestVisible="False" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12"
                                    Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                <TextBlock x:Name="ShelfGlyph" Style="{StaticResource IconGlyph}" Text="&#xE896;"
                                           FontSize="18" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <TextBlock x:Name="Headline" Text="Drop files here" FontSize="14"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="Drops stay queued until you convert."
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="5"
                                    Padding="8,2" HorizontalAlignment="Center" Margin="0,7,0,0">
                                <TextBlock x:Name="FormatSummary" Text="{Binding ShelfFormatsSummary}"
                                           FontFamily="{DynamicResource Font.Mono}" FontSize="9.5"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer: queue state + conversion action, then the output folder -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.TextFaint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanConvert}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ShelfQueueStatus}" FontSize="10"
                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button x:Name="ConvertButton" HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButton}" Content="{Binding ConvertButtonText}"
                                Padding="14,6" MinWidth="96" FontSize="11.5"
                                IsEnabled="{Binding CanConvert}" IsDefault="True" Click="Convert_Click"
                                ToolTip="Convert the queued files (Enter)" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xE8B7;" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextFaint}" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ShelfOutputDisplay}" Style="{StaticResource Caption}"
                                   FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Settings.OutputDirectory}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Change"
                                FontSize="9.5" Margin="7,0,0,0" Padding="0" VerticalAlignment="Center"
                                ToolTip="Choose another output folder"
                                Click="ChangeOutput_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
