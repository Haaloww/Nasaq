<UserControl x:Class="Nasaq.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Nasaq.Controls"
             mc:Ignorable="d"
             d:DesignHeight="630" d:DesignWidth="1080"
             Background="Transparent">

    <Grid Margin="22,16,22,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════ LEFT: QUEUE ═══════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="13" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="13" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="7" />
                <RowDefinition Height="*" />
                <RowDefinition Height="11" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Queue" Style="{StaticResource PageTitle}" />
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6"
                            Padding="7,2" Margin="10,3,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </Border>
                    <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="12,3,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ClearFinishedCommand}"
                            Margin="0,0,6,0" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE894;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Clear finished" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="13" Margin="0,0,7,0" />
                            <TextBlock Text="Add files" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Drop zone / auto-fitting image preview. The control reads the
                 image's natural dimensions and animates its own width + height. -->
            <controls:AutoImageDropZone x:Name="ImageDropZone" Grid.Row="2" Height="116" />

            <!-- Queue list header -->
            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="QUEUE" Style="{StaticResource SectionLabel}" />
                    <Border Width="3" Height="3" CornerRadius="2" Margin="8,0"
                            Background="{DynamicResource Brush.TextFaint}" />
                    <TextBlock Text="Files convert in the background" Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>

            <!-- Queue list -->
            <Grid Grid.Row="6">
                <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"
                              FocusVisualStyle="{x:Null}">
                    <ItemsControl ItemsSource="{Binding Items}" FocusVisualStyle="{x:Null}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="12" Padding="11,9" Margin="0,0,0,7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="9"
                                                Background="{DynamicResource Brush.SurfaceAlt}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource IconGlyph}" Text="{Binding Glyph}"
                                                       FontSize="14" Foreground="{DynamicResource Brush.TextMuted}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="5"
                                                    Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding TargetDescription}">
                                                <TextBlock Text="{Binding TargetLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                            <Button Style="{StaticResource IconButton}" Width="27" Height="27"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Remove from queue">
                                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" FontSize="11" />
                                            </Button>
                                        </StackPanel>

                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,6,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource SlimProgress}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Canceled">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           ToolTip="{Binding Detail}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityInverse}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">
                    <Border Width="58" Height="58" CornerRadius="17"
                            Background="{DynamicResource Brush.SurfaceAlt}" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A5;" FontSize="24"
                                   Foreground="{DynamicResource Brush.TextFaint}" />
                    </Border>
                    <TextBlock Text="Nothing queued yet" FontSize="13.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Drop files above, or add them from a folder."
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Action row -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="10" Padding="10,7" Margin="0,0,14,0"
                        ToolTip="{Binding OutputDirectoryFull}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="28" Height="28" CornerRadius="8"
                                Background="{DynamicResource Brush.AccentSoft}"
                                VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;"
                                       FontSize="13" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="SAVING TO" Style="{StaticResource SectionLabel}" FontSize="8.5" />
                            <TextBlock Text="{Binding OutputDisplay}" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource LinkButton}" Command="{Binding BrowseOutputCommand}"
                                    Content="Change" FontSize="10.5"
                                    ToolTip="Choose another output folder" />
                            <Border Width="1" Height="14" Background="{DynamicResource Brush.Border}"
                                    Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenOutputCommand}"
                                    Padding="7,4" ToolTip="Open the output folder in Explorer">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE838;"
                                               FontSize="11" Margin="0,0,5,0" />
                                    <TextBlock Text="Open folder" FontSize="10.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                            Content="Cancel" Padding="15,9" Margin="0,0,8,0"
                            Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}"
                            Content="{Binding ConvertButtonText}" MinWidth="132" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══════════════════════ RIGHT: OPTIONS ═══════════════════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">

            <!-- Output formats -->
            <Border Style="{StaticResource Card}" Padding="15,14">
                <StackPanel>
                    <TextBlock Text="OUTPUT FORMATS" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Choose the target for each file type."
                               Style="{StaticResource Caption}" Margin="0,4,0,6" />

                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xEB9F;"
                                   FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Images" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,0,7" />
                        <ComboBox Grid.Row="0" Grid.Column="2" Height="30" FontSize="11.5" Margin="0,0,0,7"
                                  ItemsSource="{Binding ImageFormats}" DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Settings.LastImageFormat, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xE8D6;"
                                   FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Audio" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,0,7" />
                        <ComboBox Grid.Row="1" Grid.Column="2" Height="30" FontSize="11.5" Margin="0,0,0,7"
                                  ItemsSource="{Binding AudioFormats}" DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Settings.LastAudioFormat, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xE714;"
                                   FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Video" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,0,7" />
                        <ComboBox Grid.Row="2" Grid.Column="2" Height="30" FontSize="11.5" Margin="0,0,0,7"
                                  ItemsSource="{Binding VideoFormats}" DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Settings.LastVideoFormat, Mode=TwoWay}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource IconGlyph}" Text="&#xE8A5;"
                                   FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Documents" FontSize="12" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="3" Grid.Column="2" Height="30" FontSize="11.5"
                                  ItemsSource="{Binding DocumentFormats}" DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Settings.LastDocumentFormat, Mode=TwoWay}" />
                    </Grid>

                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8"
                            Padding="9,7" Margin="0,9,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Extract audio from videos" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="Uses the Audio target above." Style="{StaticResource Caption}"
                                           FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.ExtractAudioFromVideo, Mode=TwoWay}"
                                          ToolTip="Turn video files into audio files using the Audio target above" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Image quality -->
            <Border Style="{StaticResource Card}" Padding="15,14" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="IMAGE QUALITY" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding Settings.ImageQuality, StringFormat={}{0}%}"
                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Grid>
                    <Slider Style="{StaticResource SlimSlider}" Minimum="40" Maximum="100"
                            IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,5,0,0"
                            Value="{Binding Settings.ImageQuality, Mode=TwoWay}" />
                    <TextBlock Text="Applies to JPG and WebP. Lossless formats ignore it."
                               Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Save location -->
            <Border Style="{StaticResource Card}" Padding="15,14" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="SAVE TO" Style="{StaticResource SectionLabel}" />
                        <Button Style="{StaticResource LinkButton}" Content="Open folder" FontSize="10.5"
                                HorizontalAlignment="Right" Command="{Binding OpenOutputCommand}" />
                    </Grid>
                    <Border Style="{StaticResource Inset}" Margin="0,8,0,0" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B7;" FontSize="13"
                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding OutputDisplay}" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OutputDirectoryFull}" />
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding BrowseOutputCommand}"
                            Content="Change folder…" Margin="0,8,0,0" Padding="10,7" FontSize="11.5" />
                </StackPanel>
            </Border>

            <!-- Shelf hint -->
            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="12"
                    Padding="13,11" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A0;" FontSize="17"
                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <StackPanel Grid.Column="1"
                                ToolTip="Ctrl-drag or press the shortcut to open the floating drop shelf">
                        <TextBlock Text="The drop shelf" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="5" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding HotkeyHint}" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <Button Style="{StaticResource LinkButton}" Command="{Binding ShowShelfCommand}"
                                    Content="Open now" FontSize="10.5" Margin="9,0,0,0"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
